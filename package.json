{
  "name": "boxy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Your snippets, offline first.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run brand && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run lint:copy",
    "lint:copy": "node scripts/lint-copy.mjs",
    "brand": "node scripts/brand/gen-tokens.mjs && node scripts/brand/recolor-logo.mjs && node scripts/brand/verify-logo.mjs && node scripts/brand/gen-icons.mjs",
    "brand:verify": "node scripts/brand/verify-logo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "VITE_LEGACY_ORIGIN=http://127.0.0.1:8099 vite build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e:only": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-virtual": "^3.13.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "dompurify": "^3.2.6",
    "fractional-indexing": "^3.2.0",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.544.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "minisearch": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "ulidx": "^2.4.1",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.27",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "svgson": "^5.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wawoff2": "^2.0.1",
    "workbox-window": "^7.3.0"
  }
}
