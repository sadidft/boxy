":"Code Snippet Example","content":"```javascript\nfunction greet(name) {\n  return `Hello, ${name}!`;\n}\n\nconsole.log(greet('World'));\n```\n\nA simple JavaScript greeting function.","tags":["code","javascript"],"pinned":false,"copyCount":0,"order":1,"createdAt":1768467600000,"updatedAt":1768467600000,"history":[{"timestamp":1768467600000,"action":"created"}],"table":null},{"id":"card_mkf7y5c0wj8mru","tabId":"tab_mkf7y5c0j1lskh","title":"Quick Reply Template","content":"Hi {{name}},\n\nThank you for reaching out! I've received your message and will get back to you within 24 hours.\n\nBest regards,\n{{sender_name}}\n\n---\nSent on {{date}} at {{time}}","tags":["email","template"],"pinned":false,"copyCount":0,"order":0,"createdAt":1768467600000,"updatedAt":1768467600000,"history":[{"timestamp":1768467600000,"action":"created"}],"table":null},{"id":"card_mkf7y5c0zgezpv","tabId":"tab_mkf7y5c0mssi3g","title":"Weekly hours","content":"Hours worked this week.","tags":["time","Time"],"pinned":true,"copyCount":3,"order":0,"createdAt":1768467600000,"updatedAt":1768467600000,"history":[{"timestamp":1768467599000,"action":"copied"}],"table":{"mode":"custom","columns":[{"id":"c1","name":"Day","order":0},{"id":"c2","name":"Start","order":1},{"id":"c3","name":"End","order":2},{"id":"c4","name":"Hours","order":3}],"rows":[{"id":"r1","cells":{"c1":"Mon","c2":"09:00","c3":"17:30","c4":"8.5"},"order":0},{"id":"r2","cells":{"c1":"Tue","c2":"10:00","c3":"16:00","c4":"6"},"order":1},{"id":"r3","cells":{"c1":"","c2":"","c3":"dur//all","c4":"sum//all"},"order":2}]}},{"id":"card_mkf7y5c0tvajak","tabId":"tab_mkf7y5c0mssi3g","title":"Invoice line","content":"Invoice {{number}} for {{client}} due {{date}}","tags":["invoice"],"pinned":false,"copyCount":0,"order":1,"createdAt":1768467600000,"updatedAt":1768467600000,"history":[],"table":null}],"allTags":["welcome","guide","code","javascript","email","template"],"actionHistory":[],"actionFuture":[]}
